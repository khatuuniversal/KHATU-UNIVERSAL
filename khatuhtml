<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Khatu Universal – Plans &amp; Payment</title>
<style>
:root{--bg:#f0f5fb;--card:#fff;--tx:#1c2a3f;--mu:#6b7a90;--bd:#e1e9f3;--in:#f6f9fd;--ac:#00baf2;--nv:#002e6e;--ok:#16a34a;--er:#dc2626;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--tx);font-family:-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;line-height:1.45}
.wrap{max-width:980px;margin:0 auto;padding:16px}
.nav{display:flex;gap:8px;margin-bottom:10px}
.navb{flex:1;border:1px solid #cfdcec;background:#fff;color:var(--nv);border-radius:10px;padding:11px 4px;font-weight:700;font-size:13px;cursor:pointer}
.navb:active{background:#e8f8fe}
header{background:var(--nv);margin:0 -16px 16px;padding:18px 16px;border-radius:0 0 18px 18px;perspective:600px;display:flex;align-items:center;justify-content:space-between;gap:10px}
h1{margin:0;font-size:21px;color:#fff;transform-origin:50% 100%}
.sub{font-size:12px;color:#8fd9f7}
@keyframes flipx{from{transform:rotateX(90deg);opacity:0}to{transform:none;opacity:1}}
.card{background:var(--card);border:1px solid var(--bd);border-radius:14px;padding:18px;box-shadow:0 1px 5px rgba(0,46,110,.08);margin-bottom:16px}
h2{font-size:16px;margin:0 0 12px}
.grid{display:none;gap:16px;grid-template-columns:1fr}
@media(min-width:760px){.grid{grid-template-columns:1fr 1fr}}
.hgrid{display:grid;gap:12px;grid-template-columns:repeat(auto-fill,minmax(150px,1fr))}
.pcard{border:2px solid var(--pc);border-radius:14px;overflow:hidden;background:#fff;cursor:pointer;text-align:left;padding:0;font:inherit;color:inherit;display:flex;flex-direction:column}
.pcard .h{background:var(--pc);color:#fff;font-weight:800;letter-spacing:1.5px;font-size:12px;padding:7px 12px}
.pcard .p{font-size:26px;font-weight:800;padding:8px 12px 0}.pcard .p small{font-size:12px;color:var(--mu);font-weight:600}
.pcard ul{list-style:none;margin:6px 12px 8px;padding:0;font-size:13px;flex:1}.pcard li:before{content:"";display:inline-block;width:5px;height:9px;border:solid var(--pc);border-width:0 2px 2px 0;transform:rotate(45deg);margin-right:9px;position:relative;top:-2px}
.pcard .b{margin:0 12px 12px;background:var(--pc);color:#fff;text-align:center;padding:9px;border-radius:9px;font-weight:700;font-size:13px}
.pcard:active{transform:scale(.98)}
.pcard.max{grid-column:1/-1;background:linear-gradient(135deg,#ff1744,#b71c1c);border-color:#ff1744;color:#fff}
.max .h{background:rgba(0,0,0,.22)}.max .p small{color:#ffd9e0}.max li:before{border-color:#fff}.max .b{background:#fff;color:#e11d48}
label{display:block;font-size:13px;color:var(--mu);margin:14px 0 6px}
input{width:100%;padding:13px 14px;border-radius:10px;border:1px solid #cfdcec;background:#fff;color:var(--tx);font-size:16px;outline:none}
input:focus{border-color:var(--ac);box-shadow:0 0 0 3px rgba(0,186,242,.15)}
input[readonly]{background:var(--in);font-weight:700}
.btn{border:0;border-radius:10px;padding:14px;font-size:15px;font-weight:700;cursor:pointer;color:#fff;background:var(--ac);width:100%}
.btn:active{transform:scale(.98)}
.btn.app{background:#fff;color:var(--nv);border:1px solid var(--ac)}.btn.app.full{background:var(--ac);color:#fff}
.apps{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:6px}.apps .full{grid-column:1/-1}
#sel{border-left:6px solid var(--pc,#00baf2);background:var(--in);border-radius:10px;padding:10px 12px;display:flex;flex-direction:column;font-size:15px}
#sel span{font-size:12px;color:var(--mu)}
.hint{font-size:12px;color:var(--mu);margin-top:8px}
.cap{text-align:center;font-size:13px;color:var(--mu)}
.qr{display:grid;place-items:center;margin:6px auto 10px}
#qr{background:#fff;padding:12px;border-radius:14px;border:1px solid var(--bd);width:204px;height:204px;display:grid;place-items:center;cursor:pointer}
.upi{display:flex;gap:8px;align-items:center;background:#f0f9fe;border:1px dashed var(--ac);border-radius:12px;padding:8px 8px 8px 14px;margin-top:12px}
.upi code{flex:1;font-size:14px;word-break:break-all;font-weight:600}
.copy{border:0;background:var(--ac);color:#fff;border-radius:8px;padding:9px 14px;font-weight:600;cursor:pointer}
.steps{font-size:13px;color:var(--mu);margin:0;padding-left:18px}
#mine{display:none;align-items:center;justify-content:space-between;gap:10px;border-left:6px solid var(--pc);background:#fff;border-radius:12px;padding:12px;margin-bottom:16px;border:1px solid var(--bd);border-left:6px solid var(--pc);font-size:14px;font-weight:600}
.planbox{max-width:560px;margin:0 auto 16px;text-align:center}
.pb{display:inline-block;color:#fff;font-size:12px;font-weight:800;letter-spacing:1px;padding:5px 12px;border-radius:99px;margin-bottom:10px}
.rows{text-align:left;margin:12px 0}.rows div{display:flex;justify-content:space-between;gap:12px;padding:10px 0;border-bottom:1px solid var(--bd);font-size:14px}.rows span{color:var(--mu)}.rows b{text-align:right;word-break:break-word}
.bar{height:8px;background:var(--in);border-radius:99px;overflow:hidden;border:1px solid var(--bd);margin-top:6px}.bar i{display:block;height:100%;width:100%;background:linear-gradient(90deg,var(--ac),var(--nv))}
#pret{display:none;align-items:center;justify-content:center;gap:8px;margin:12px 0;font-size:14px;background:var(--in);padding:10px;border-radius:10px}
.prow{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:10px 12px;border-left:4px solid var(--pc);background:var(--in);border-radius:10px;margin-bottom:8px;font-size:14px;text-align:left}
.prow b{letter-spacing:2px}.prow small{display:block;color:var(--mu);font-size:12px}.pamt2{font-weight:800;color:var(--pc)}
details summary{cursor:pointer;font-weight:700;font-size:15px;color:var(--nv)}
table{width:100%;border-collapse:collapse;font-size:13px;margin-top:12px;min-width:460px}th,td{padding:9px 8px;border-bottom:1px solid var(--bd);text-align:left}th{color:var(--mu);font-weight:600}
.dot{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:6px;background:var(--pc)}
.disc{margin:18px 0 8px;font-size:12px;color:var(--mu);text-align:center;border-top:1px solid var(--bd);padding-top:14px}
.modal{position:fixed;inset:0;background:rgba(10,20,45,.55);display:none;align-items:center;justify-content:center;padding:20px;z-index:50}
.modal.show{display:flex}
.box{background:#fff;border-radius:18px;padding:26px 22px;max-width:380px;width:100%;text-align:center}
.ic{width:62px;height:62px;border-radius:50%;margin:0 auto 12px;display:grid;place-items:center;font-size:30px;color:#fff}
.box h3{margin:0 0 8px;font-size:18px}.box p{margin:0 0 18px;color:var(--mu);font-size:14px}
select{width:100%;padding:13px 14px;border-radius:10px;border:1px solid #cfdcec;background:#fff;color:var(--tx);font-size:16px}
.navb svg,.btn svg{vertical-align:-3px;margin-right:6px}
.pcard{cursor:default}
.b2{display:flex;gap:8px;margin:0 12px 8px}
.pcard .b2 .b{margin:0;border:0;cursor:pointer;font:inherit;font-weight:700;font-size:13px;padding:9px 4px;border-radius:9px;background:var(--pc);color:#fff;flex:1}
.pcard.max .b2 .b{background:#fff;color:#e11d48}
.vm{margin:0 12px 12px;border:1px solid var(--pc);background:transparent;color:var(--pc);border-radius:9px;padding:8px;font:inherit;font-weight:700;font-size:13px;cursor:pointer}
.max .vm{color:#fff;border-color:#fff}
.tabs{display:flex;gap:8px;margin-bottom:12px}
.tab{flex:1;padding:11px;border-radius:10px;border:1px solid #cfdcec;background:#fff;color:var(--nv);font-weight:700;cursor:pointer;font-size:14px}
.tab.on{background:var(--nv);color:#fff;border-color:var(--nv)}
.dbtn{border:0;border-radius:10px;padding:13px;font-weight:700;font-size:14px;cursor:pointer;flex:1;background:var(--pc);color:#fff}
.dbtn.o{background:#fff;color:var(--nv);border:1px solid #cfdcec}
button{position:relative;overflow:hidden;transition:transform .15s,box-shadow .2s,filter .2s}
button:active{transform:scale(.95)}
@media (hover:hover){button:hover{filter:brightness(1.06)}.btn:hover,.dbtn:hover,.pcard .b2 .b:hover{transform:translateY(-1px);box-shadow:0 6px 14px rgba(0,46,110,.18)}}
.rip{position:absolute;border-radius:50%;background:currentColor;opacity:.25;transform:scale(0);animation:rip .6s ease-out;pointer-events:none}
@keyframes rip{to{transform:scale(2.6);opacity:0}}
@keyframes fadeup{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
@keyframes pop{0%{transform:scale(.6);opacity:0}70%{transform:scale(1.12)}100%{transform:scale(1);opacity:1}}
@keyframes boxin{from{transform:scale(.9);opacity:0}to{transform:none;opacity:1}}
.pcard{animation:fadeup .45s ease backwards;animation-delay:calc(var(--i,0) * 60ms)}
.pcard .p{display:block;transform-origin:left center;animation:pop .5s ease backwards;animation-delay:calc(var(--i,0) * 60ms + 150ms);transition:transform .2s}
.pcard:hover .p{transform:scale(1.06)}
#sel b{display:inline-block;animation:pop .45s ease backwards}
#homeview,#detailview,#planview,#paywrap{animation:fadeup .35s ease backwards}
.modal.show .box{animation:boxin .25s ease}
.tab{transition:background .2s,color .2s,transform .15s}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
header{background:linear-gradient(135deg,#002e6e,#0050b3);box-shadow:0 4px 14px rgba(0,46,110,.25)}
.dnw{display:flex;align-items:center;gap:8px;color:#cfe9ff;font-size:12px;font-weight:700}
.dl{cursor:pointer;opacity:.75}
.dn{width:64px;height:32px;border-radius:16px;border:0;padding:0;background:linear-gradient(135deg,#7ed0f7,#d7f1ff);box-shadow:inset 0 0 0 2px rgba(255,255,255,.4);transition:background .5s;flex:none}
.knob{position:absolute;top:3px;left:3px;width:26px;height:26px;border-radius:50%;background:#ffd23f;box-shadow:0 0 12px #ffd23f;transition:left .5s cubic-bezier(.5,1.6,.5,1),background .5s,box-shadow .5s,transform .6s}
.dn:after{content:"";position:absolute;left:10px;top:8px;width:3px;height:3px;border-radius:50%;background:#fff;box-shadow:12px 10px 0 #fff,22px 2px 0 #fff;opacity:0;transition:opacity .5s}
:root[data-theme="dark"]{--bg:#0a1325;--card:#111e38;--tx:#e8f0fb;--mu:#93a6c3;--bd:#22365a;--in:#0e1a33;--nv:#cfe9ff}
:root[data-theme="dark"] .dn{background:linear-gradient(135deg,#0b1a3a,#2b3a73)}
:root[data-theme="dark"] .dn:after{opacity:1}
:root[data-theme="dark"] .knob{left:35px;background:radial-gradient(circle at 30% 35%,#c9cfe6 0 14%,transparent 15%),radial-gradient(circle at 65% 60%,#c9cfe6 0 10%,transparent 11%),#eef1ff;box-shadow:0 0 10px rgba(220,225,255,.6);transform:rotate(360deg)}
:root[data-theme="dark"] header{background:linear-gradient(135deg,#07142e,#12306b)}
:root[data-theme="dark"] .navb,:root[data-theme="dark"] .tab,:root[data-theme="dark"] .btn.app,:root[data-theme="dark"] .dbtn.o,:root[data-theme="dark"] #mine,:root[data-theme="dark"] .box,:root[data-theme="dark"] .pcard:not(.max){background:var(--card);border-color:var(--bd)}
:root[data-theme="dark"] .pcard:not(.max){border-color:var(--pc)}
:root[data-theme="dark"] .btn.app{color:var(--ac)}
:root[data-theme="dark"] .btn.app.full{background:var(--ac);color:#fff}
:root[data-theme="dark"] .tab.on{background:var(--ac);color:#fff;border-color:var(--ac)}
:root[data-theme="dark"] .dbtn.o{color:var(--tx)}
:root[data-theme="dark"] input,:root[data-theme="dark"] select{background:var(--in);color:var(--tx);border-color:var(--bd)}
:root[data-theme="dark"] .upi{background:#0e2a45}
:root[data-theme="dark"] .box{color:var(--tx)}
body,.card,input,select,.navb,.tab,.pcard,header{transition:background-color .4s,color .4s,border-color .4s}
.box{position:relative;overflow:hidden}
.coin{width:64px;height:64px;border-radius:50%;background:linear-gradient(135deg,#ffe082,#ffb300);border:4px solid #ffca28;display:grid;place-items:center;font-weight:800;color:#8a5a00;font-size:28px;animation:coinf 1s linear infinite;box-shadow:0 4px 14px rgba(255,179,0,.5)}
@keyframes coinf{from{transform:rotateY(0)}to{transform:rotateY(360deg)}}
.ic.ok{animation:pop .5s ease,ringp 1s ease-out .3s}
@keyframes ringp{from{box-shadow:0 0 0 0 rgba(22,163,74,.5)}to{box-shadow:0 0 0 26px rgba(22,163,74,0)}}
@keyframes drawp{from{stroke-dashoffset:1}to{stroke-dashoffset:0}}
.okc path{stroke-dasharray:1;stroke-dashoffset:1;animation:drawp .5s ease .35s forwards}
.cf{position:absolute;top:-12px;width:8px;height:12px;border-radius:2px;animation:cfall 1.6s ease-in forwards;pointer-events:none}
@keyframes cfall{to{top:110%;opacity:.2}}
.draw svg path{stroke-dasharray:1;animation:drawp .7s ease forwards}
.spin svg{animation:rot .65s ease}
@keyframes rot{to{transform:rotate(360deg)}}
.hero{background:linear-gradient(135deg,#002e6e,#00a3d9);color:#fff;border-radius:16px;padding:20px;margin-bottom:14px;box-shadow:0 6px 18px rgba(0,46,110,.2)}
.hero h2{font-size:22px;margin:0 0 6px;color:#fff}.hero p{margin:0 0 12px;font-size:14px;opacity:.92}
.trust{display:flex;flex-wrap:wrap;gap:8px}.trust span{background:rgba(255,255,255,.16);border-radius:99px;padding:6px 11px;font-size:12px;font-weight:700}.trust svg{vertical-align:-3px;margin-right:5px}
.steps2{display:none;align-items:center;justify-content:center;gap:8px;margin:0 0 14px;font-size:13px;font-weight:700;color:var(--mu)}
.st{display:flex;align-items:center;gap:6px}.st i{width:24px;height:24px;border-radius:50%;background:var(--bd);color:var(--mu);display:grid;place-items:center;font-style:normal;font-size:12px;transition:background .3s}
.st.on{color:var(--tx)}.st.on i{background:var(--ac);color:#fff}.st.done i{background:var(--ok);color:#fff}.ln{width:28px;height:2px;background:var(--bd)}
</style>
</head>
<body>
<div class="wrap">
<div class="nav">
  <button class="navb" id="nhome" type="button" data-ico="home">Home Page</button>
  <button class="navb" id="nplan" type="button" data-ico="plan">Plan Page</button>
  <button class="navb" id="nrefresh" type="button" data-ico="refresh">Refresh</button>
</div>
<header><div><h1 id="flip">Khatu Payment</h1><div class="sub">Khatu Universal · v9.0</div></div><div class="dnw"><span class="dl" data-t="light">Day</span><button class="dn" id="dn" type="button" aria-label="Switch between day and night"><i class="knob"></i></button><span class="dl" data-t="dark">Night</span></div></header>

<div class="steps2" id="steps"><div class="st done"><i>1</i>Plan</div><div class="ln"></div><div class="st" id="s2"><i>2</i>Pay</div><div class="ln"></div><div class="st" id="s3"><i>3</i>Receipt</div></div>
<section id="homeview">
  <div class="hero"><h2>Upgrade in under a minute</h2><p>Pick a plan, pay with any UPI app and get your plan slip right away.</p><div class="trust"><span data-ico="shield">Secure UPI payment</span><span data-ico="bolt">Quick plan slip</span><span data-ico="mail">Receipt on email</span></div></div>
  <div id="toolnote" class="card" style="display:none;margin-bottom:12px;font-weight:700;color:var(--nv)"></div>
  <div id="mine"><span id="minetx"></span><button class="copy" id="mineb" type="button">View Plan</button></div>
  <div class="card">
    <div class="tabs"><button class="tab on" id="tabm" type="button">Main Plans</button><button class="tab" id="tabg" type="button">Groceries Plans</button></div>
    <h2 id="settitle">Main plans</h2>
    <div class="hgrid" id="hgrid"></div>
    <div class="hint" id="setnote"></div>
  </div>
  <details class="card" id="more">
    <summary>View more: all plans &amp; facilities</summary>
    <div id="ptable" style="overflow-x:auto"></div>
    <div class="hint">Free tools are included in every plan. The Max plan is the boss plan: all tools are free after you buy it.</div>
  </details>
<section class="card planbox">
  <h2>Recent Purchases</h2>
  <div id="plist"></div>
  <div class="hint">Names are partly hidden to protect privacy.</div>
</section>
<section class="card planbox">
  <h2>Verify a Plan Code</h2>
  <input id="vcode" type="text" autocomplete="off" autocapitalize="characters" placeholder="e.g. KU/01/2026/0001">
  <div style="height:10px"></div>
  <button class="btn" id="vcheck" type="button">Verify Code</button>
  <div id="vres" style="white-space:pre-line;margin-top:12px;font-weight:600;font-size:14px"></div>
</section>

<details class="card"><summary>Developer tools: plan link for your tool</summary><div style="margin-top:10px">
  <label for="lgtool">Tool name (shown to the user and on the receipt)</label>
  <input id="lgtool" type="text" placeholder="e.g. AI Image Maker" maxlength="60">
  <label for="lgset">Plan page</label><select id="lgset"><option value="main">Main plans</option><option value="groc">Groceries plans</option></select>
  <label for="lgplan">Plan</label><select id="lgplan"></select>
  <label for="lgret">Return URL (where the user goes after payment)</label>
  <input id="lgret" type="text" placeholder="https://your-tool.com/upgrade" autocapitalize="off">
  <div class="upi"><code id="lgout"></code><button class="copy" id="lgcopy" type="button">Copy</button></div>
  <div class="hint">Put this link on the Upgrade button in your tool. The user lands here with the plan already selected, pays, enters the UTR and is sent back to your Return URL.</div>
</div></details>
</section>

<section id="detailview" style="display:none"><div class="card" id="dcard"></div></section>

<div class="grid" id="paywrap">
  <section class="card">
    <h2>1. Your selected plan</h2>
    <div id="sel"></div>
    <button class="btn app" id="chg" type="button" style="margin-top:10px" data-ico="back">Change plan</button>
    <div class="hint" id="retnote"></div>
    <label for="amount">Amount (INR)</label>
    <input id="amount" type="number" readonly>
    <label for="name">Your name (required)</label>
    <input id="name" type="text" placeholder="Full name" maxlength="40">
    <label for="email">Email for your receipt (required)</label>
    <input id="email" type="email" placeholder="you@example.com" autocomplete="email" autocapitalize="off">
    <h2 style="margin-top:20px">2. Pay with your app</h2>
    <div class="apps">
      <button class="btn app full" data-app="upi" type="button">Pay with any UPI app</button>
      <button class="btn app" data-app="gpay" type="button">Google Pay</button>
      <button class="btn app" data-app="phonepe" type="button">PhonePe</button>
      <button class="btn app" data-app="paytm" type="button">Paytm</button>
      <button class="btn app" data-app="bhim" type="button">BHIM / Others</button>
    </div>
    <div class="hint">Tap your app. It opens with the amount filled in. If your app shows an error, scan the QR or copy the UPI ID and pay manually. The UTR number is needed only after the payment is done.</div>
  </section>
  <section class="card">
    <h2>Scan QR to pay</h2>
    <div class="qr"><div id="qr"></div></div>
    <div class="cap" id="qrcap">Scan with any UPI app</div>
    <button class="btn app" id="qrdl" type="button" style="margin-top:10px" data-ico="dl">Download QR</button>
    <div class="upi"><code id="upiid"></code><button class="copy" id="copy" type="button">Copy</button></div>
    <h2 style="margin-top:22px">3. Verify your payment</h2>
    <ol class="steps"><li>Pay first using the buttons, QR or UPI ID.</li><li>After payment, copy the 12-digit UTR / Reference No. from your app.</li><li>Enter it below and submit.</li></ol>
    <label for="utr">UTR / Transaction Reference No.</label>
    <input id="utr" type="text" maxlength="12" autocomplete="off" autocapitalize="characters" placeholder="12-digit UTR number">
    <div style="height:12px"></div>
    <button class="btn" id="verify" type="button">Verify &amp; Submit Payment</button>
  </section>
</div>

<section class="card planbox" id="planview" style="display:none">
  <div class="pb" id="pbadge"></div>
  <h2 id="ptitle" style="font-size:20px"></h2>
  <div id="pwho" style="font-size:17px;font-weight:800;margin:2px 0 4px"></div>
  <div class="rows">
    <div id="
